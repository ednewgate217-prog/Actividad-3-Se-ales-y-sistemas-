fig, ax = plt.subplots(2, 1, figsize=(10, 6))

ax[0].plot(t, senal, color='gray')
ax[0].set_title('Señal original (10 Hz + 200 Hz)')
ax[0].set_xlabel('Tiempo (s)')
ax[0].set_ylabel('Amplitud')
ax[0].grid(True)

ax[1].plot(t, senal_filtrada, color='darkorange', label='Señal filtrada (HP 150 Hz)')
ax[1].set_title('Señal después del filtro pasa altos')
ax[1].set_xlabel('Tiempo (s)')
ax[1].set_ylabel('Amplitud')
ax[1].legend()
ax[1].grid(True)

plt.tight_layout()
